<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- ============================================================ -->
    <!-- ELECTRIC VEHICLE TYPES WITH REAL BANGLADESH MARKET DATA -->
    <!-- Based on actual Easy Bike, E-Rickshaw, and E-Van specifications -->
    <!-- ============================================================ -->
    
    <!-- 
    EASY BIKE (E-Bike/Easy Bike Standard)
    Real Market Data:
    - Models: Easy Bike Ltd., Auto Gari Standard, Mishuk
    - Motor: 800W-1000W (Average: 900W)- Mid range
    - Battery: 60V 45Ah = 2.7 kWh
    - Range: 60-100 km average
    - Price: 1,15,000 - 1,80,000 BDT
    - Weight: 200 kg + 500 kg load capacity
    -->
    <vType id="easyBike"
       accel="1.2" decel="2.5" sigma="0.8"
       length="2.2" width="0.8" height="1.4"
       maxSpeed="19.44"
       color="0.9,0.3,0.9"
       minGap="0.5" tau="0.9" speedFactor="1.05"
       emissionClass="Energy/unknown">

    <!-- Battery Device Parameters -->
    <param key="has.battery.device" value="true"/>
    <param key="maximumBatteryCapacity" value="2700"/>    <!-- 2.7 kWh (60V 45Ah) -->
    <param key="actualBatteryCapacity" value="2430"/>     <!-- 90% initial -->
    <param key="maximumPower" value="900"/>               <!-- 900 W motor -->
    
    <param key="vehicleMass" value="350"/>                <!-- Total weight -->
    <param key="frontSurfaceArea" value="1.0"/>
    <param key="airDragCoefficient" value="0.75"/>
    <param key="internalMomentOfInertia" value="0.01"/>
    <param key="radialDragCoefficient" value="0.12"/>
    <param key="rollDragCoefficient" value="0.015"/>
    <param key="constantPowerIntake" value="30"/>         
    <param key="propulsionEfficiency" value="0.82"/>
    <param key="recuperationEfficiency" value="0.65"/>
    <param key="stoppingThreshold" value="0.1"/>
</vType>

    
    <!-- 
    E-RICKSHAW (Electric Rickshaw)
    Real Market Data:
    - Models: Mishuk, TomTom
    - Motor: 700W-900W 
    - Battery: 48V 150Ah = 7.2 kWh
    - Range: 60 km
    - Price: 1,00,000 - 1,50,000 BDT
    - Weight: 160 kg + 240 kg load capacity
    -->
    <vType id="eRickshaw" 
           accel="0.6" decel="2.5" sigma="0.7" 
           length="2.5" width="1.0" height="1.8" 
           maxSpeed="8.33" 
           color="0,0.9,0" 
           minGap="0.8" tau="2.0" speedFactor="0.8" 
           emissionClass="Energy/unknown">
          <!-- Battery Device Parameters -->
        <param key="has.battery.device" value="true"/>
        <param key="maximumBatteryCapacity" value="7200"/>    <!-- 7.2 kWh (48V 150Ah) -->
        <param key="actualBatteryCapacity" value="6480"/>     <!-- 90% initial -->
        <param key="maximumPower" value="1200"/>              <!-- 1200 W common upgrade -->
        
        <param key="vehicleMass" value="200"/>                
        <param key="frontSurfaceArea" value="1.5"/>
        <param key="airDragCoefficient" value="0.90"/>
        <param key="internalMomentOfInertia" value="0.01"/>
        <param key="radialDragCoefficient" value="0.15"/>
        <param key="rollDragCoefficient" value="0.018"/>
        <param key="constantPowerIntake" value="25"/>
        <param key="propulsionEfficiency" value="0.78"/>
        <param key="recuperationEfficiency" value="0.50"/>
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- 
    E-VAN (Electric Van)
    Real Market Data:
    - Motor: 700W-900W 
    - Battery: 48V 150Ah = 7.2 kWh 
    - Range: 60 km
    - Price: 1,00,000 - 1,50,000 BDT
    - Weight: 160 kg + 240 kg load capacity
    -->
    <vType id="eVan" 
           accel="0.7" decel="3.2" sigma="0.6" 
           length="2.5" width="2.0" height="2.2" 
           maxSpeed="13.89" 
           color="0.2,0.6,0.9" 
           minGap="2.0" tau="1.8" speedFactor="0.85" 
           emissionClass="Energy/unknown">
        <!-- Battery Device Parameters  -->
         <param key="has.battery.device" value="true"/>
        <param key="maximumBatteryCapacity" value="7200"/>     <!-- 7.2 kWh actual market -->
        <param key="actualBatteryCapacity" value="6480"/>      <!-- 90% initial -->
        <param key="maximumPower" value="2500"/>               <!-- 2.5 kW realistic use -->

        <param key="vehicleMass" value="200"/>                 <!-- Heavy van -->
        <param key="frontSurfaceArea" value="2.4"/>
        <param key="airDragCoefficient" value="0.85"/>
        <param key="internalMomentOfInertia" value="0.01"/>
        <param key="radialDragCoefficient" value="0.18"/>
        <param key="rollDragCoefficient" value="0.015"/>
        <param key="constantPowerIntake" value="80"/>
        <param key="propulsionEfficiency" value="0.85"/>
        <param key="recuperationEfficiency" value="0.70"/>
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- Route 1: N1 -> N2 -> N3 -> N4 -> N9 (via upper path) -->
    <route id="route1" edges="E0 E1 E2 E3"/>
    
    <!-- Route 2: N1 -> N2 -> N3 -> N8 -> N9 (via middle path) -->
    <route id="route2" edges="E0 E1 E9 E8"/>
    
    <!-- Route 3: N1 -> N5 -> N6 -> N7 -> N8 -> N9 (via lower path) -->
    <route id="route3" edges="E4 E5 E6 E7 E8"/>
    
    <!-- Easy Bikes on all routes - Higher frequency -->
    <flow id="easyBike_route1" type="easyBike" route="route1" begin="0" end="3600" vehsPerHour="180" departPos="base" departLane="best"/>
    <flow id="easyBike_route2" type="easyBike" route="route2" begin="0" end="3600" vehsPerHour="150" departPos="base" departLane="best"/>
    <flow id="easyBike_route3" type="easyBike" route="route3" begin="0" end="3600" vehsPerHour="120" departPos="base" departLane="best"/>
    
    <!-- E-Rickshaws on all routes - Medium frequency -->
    <flow id="eRickshaw_route1" type="eRickshaw" route="route1" begin="0" end="3600" vehsPerHour="90" departPos="base" departLane="best"/>
    <flow id="eRickshaw_route2" type="eRickshaw" route="route2" begin="0" end="3600" vehsPerHour="75" departPos="base" departLane="best"/>
    <flow id="eRickshaw_route3" type="eRickshaw" route="route3" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    
    <!-- E-Vans on all routes - Lower frequency -->
    <flow id="eVan_route1" type="eVan" route="route1" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    <flow id="eVan_route2" type="eVan" route="route2" begin="0" end="3600" vehsPerHour="45" departPos="base" departLane="best"/>
    <flow id="eVan_route3" type="eVan" route="route3" begin="0" end="3600" vehsPerHour="30" departPos="base" departLane="best"/>

</routes>
