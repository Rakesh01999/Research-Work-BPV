<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- Electric Easy Bike (Most common) -->
    <vType id="easyBike" accel="1.2" decel="4.5" sigma="0.8" 
           length="2.2" width="0.8" height="1.4" maxSpeed="19.44" color="0.9,0.3,0.9" 
           minGap="0.5" tau="0.9" speedFactor="1.05" 
           emissionClass="Energy/unknown"/>
    
    <!-- Electric Rickshaw (E-Rickshaw) -->
    <vType id="eRickshaw" accel="0.6" decel="2.5" sigma="0.7" 
           length="2.5" width="1.0" height="1.8" maxSpeed="6.94" color="0,0.9,0" 
           minGap="0.8" tau="2.0" speedFactor="0.8" 
           emissionClass="Energy/unknown"/>
    
    <!-- Electric Van (Battery Van) -->
    <vType id="eVan" accel="0.7" decel="3.2" sigma="0.6" 
           length="2.5" width="2.0" height="2.2" maxSpeed="13.89" color="0.2,0.6,0.9" 
           minGap="2.0" tau="1.8" speedFactor="0.85" 
           emissionClass="Energy/unknown"/>
    
    <!-- Route 1: N1 -> N2 -> N3 -> N4 -> N9 (via upper path) -->
    <route id="route1" edges="E0 E1 E2 E3"/>
    
    <!-- Route 2: N1 -> N2 -> N3 -> N8 -> N9 (via middle path) -->
    <route id="route2" edges="E0 E1 E9 E8"/>
    
    <!-- Route 3: N1 -> N5 -> N6 -> N7 -> N8 -> N9 (via lower path) -->
    <route id="route3" edges="E4 E5 E6 E7 E8"/>
    
    <!-- Easy Bikes on all routes - Higher frequency, use both lanes -->
    <flow id="easyBike_route1" type="easyBike" route="route1" begin="0" end="3600" vehsPerHour="180" departPos="base" departLane="best"/>
    <flow id="easyBike_route2" type="easyBike" route="route2" begin="0" end="3600" vehsPerHour="150" departPos="base" departLane="best"/>
    <flow id="easyBike_route3" type="easyBike" route="route3" begin="0" end="3600" vehsPerHour="120" departPos="base" departLane="best"/>
    
    <!-- E-Rickshaws on all routes - Medium frequency -->
    <flow id="eRickshaw_route1" type="eRickshaw" route="route1" begin="0" end="3600" vehsPerHour="90" departPos="base" departLane="best"/>
    <flow id="eRickshaw_route2" type="eRickshaw" route="route2" begin="0" end="3600" vehsPerHour="75" departPos="base" departLane="best"/>
    <flow id="eRickshaw_route3" type="eRickshaw" route="route3" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    
    <!-- E-Vans on all routes - Lower frequency -->
    <flow id="eVan_route1" type="eVan" route="route1" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    <flow id="eVan_route2" type="eVan" route="route2" begin="0" end="3600" vehsPerHour="45" departPos="base" departLane="best"/>
    <flow id="eVan_route3" type="eVan" route="route3" begin="0" end="3600" vehsPerHour="30" departPos="base" departLane="best"/>

</routes>
