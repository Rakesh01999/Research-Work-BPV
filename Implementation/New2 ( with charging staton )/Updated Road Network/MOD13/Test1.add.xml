<?xml version="1.0" encoding="UTF-8"?>
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- Convert Node3 to traffic light junction -->
    <tlLogic id="Node3" type="static" programID="0" offset="0">
        <!-- Phase 0: Main road E1 -> E2 (straight through) - GREEN (60 seconds) -->
        <!-- Connection order from net.xml: E1->E9 (indices 0,1), E1->E2 (indices 2,3) -->
        <phase duration="60" state="rrGG"/>
        
        <!-- Phase 1: Yellow transition (3 seconds) -->
        <phase duration="3" state="rryy"/>
        
        <!-- Phase 2: E1 -> E9 (right turn to Node8) - GREEN (30 seconds) -->
        <phase duration="30" state="GGrr"/>
        
        <!-- Phase 3: Yellow transition (3 seconds) -->
        <phase duration="3" state="yyrr"/>
    </tlLogic>

    <!-- Convert Node8 to traffic light junction -->
    <tlLogic id="Node8" type="static" programID="0" offset="0">
        <!-- Phase 0: E7 -> E8 (straight through from Node7) - GREEN (50 seconds) -->
        <!-- Connection order from net.xml: E9->E8 (indices 0,1), E7->E8 (indices 2,3) -->
        <phase duration="50" state="rrGG"/>
        
        <!-- Phase 1: Yellow transition (3 seconds) -->
        <phase duration="3" state="rryy"/>
        
        <!-- Phase 2: E9 -> E8 (left turn from Node3) - GREEN (35 seconds) -->
        <phase duration="35" state="GGrr"/>
        
        <!-- Phase 3: Yellow transition (3 seconds) -->
        <phase duration="3" state="yyrr"/>
        
        <!-- Phase 4: All red safety clearance - Bangladesh typical (2 seconds) -->
        <phase duration="2" state="rrrr"/>
    </tlLogic>

</additional>