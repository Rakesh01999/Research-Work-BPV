<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">
    
    <!-- ============================================================ -->
    <!-- ELECTRIC VEHICLE TYPES WITH REAL BANGLADESH MARKET DATA -->
    <!-- Based on actual Easy Bike, E-Rickshaw, and E-Van specifications -->
    <!-- ============================================================ -->
    
    <!-- EASY BIKE (E-Bike/Easy Bike Standard) -->
    <vType id="easyBike"
       accel="1.2" decel="2.5" sigma="0.8"
       length="2.5" width="1.5" height="1.4"
       maxSpeed="8.4"
       color="0.9,0.3,0.9"
       minGap="0.5" tau="0.9" speedFactor="1.05"
       emissionClass="Energy/unknown">

    <param key="has.battery.device" value="true"/>
    <param key="maximumBatteryCapacity" value="2700"/>
    <param key="actualBatteryCapacity" value="864"/>
    <param key="maximumPower" value="900"/>
    
    <param key="vehicleMass" value="350"/>
    <param key="frontSurfaceArea" value="1.0"/>
    <param key="airDragCoefficient" value="0.75"/>
    <param key="internalMomentOfInertia" value="0.01"/>
    <param key="radialDragCoefficient" value="0.12"/>
    <param key="rollDragCoefficient" value="0.015"/>
    <param key="constantPowerIntake" value="30"/>
    <param key="propulsionEfficiency" value="0.82"/>
    <param key="recuperationEfficiency" value="0.65"/>
    <param key="stoppingThreshold" value="0.1"/>
</vType>
    
    <!-- E-RICKSHAW (Electric Rickshaw) -->
    <vType id="eRickshaw" 
           accel="0.6" decel="2.5" sigma="0.7" 
           length="2.3" width="1.0" height="1.8" 
           maxSpeed="8.2" 
           color="0,0.9,0" 
           minGap="0.8" tau="2.0" speedFactor="0.8" 
           emissionClass="Energy/unknown">
        <param key="has.battery.device" value="true"/>
        <param key="maximumBatteryCapacity" value="7200"/>
        <param key="actualBatteryCapacity" value="2232"/>
        <param key="maximumPower" value="1200"/>
        
        <param key="vehicleMass" value="200"/>
        <param key="frontSurfaceArea" value="1.5"/>
        <param key="airDragCoefficient" value="0.90"/>
        <param key="internalMomentOfInertia" value="0.01"/>
        <param key="radialDragCoefficient" value="0.15"/>
        <param key="rollDragCoefficient" value="0.018"/>
        <param key="constantPowerIntake" value="25"/>
        <param key="propulsionEfficiency" value="0.78"/>
        <param key="recuperationEfficiency" value="0.50"/>
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- E-VAN (Electric Van) -->
    <vType id="eVan" 
           accel="0.7" decel="2.6" sigma="0.6" 
           length="2.4" width="1.3" height="2.2" 
           maxSpeed="7.8" 
           color="0.2,0.6,0.9" 
           minGap="2.0" tau="1.8" speedFactor="0.85" 
           emissionClass="Energy/unknown">
        <param key="has.battery.device" value="true"/>
        <param key="maximumBatteryCapacity" value="7200"/>
        <param key="actualBatteryCapacity" value="2376"/>
        <param key="maximumPower" value="2500"/>

        <param key="vehicleMass" value="200"/>
        <param key="frontSurfaceArea" value="2.4"/>
        <param key="airDragCoefficient" value="0.85"/>
        <param key="internalMomentOfInertia" value="0.01"/>
        <param key="radialDragCoefficient" value="0.18"/>
        <param key="rollDragCoefficient" value="0.015"/>
        <param key="constantPowerIntake" value="80"/>
        <param key="propulsionEfficiency" value="0.85"/>
        <param key="recuperationEfficiency" value="0.70"/>
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- ============================================================ -->
    <!-- FORWARD ROUTES (Node1 → Node9) -->
    <!-- ============================================================ -->
    
    <!-- Route 1: N1 → N2 → N3 → N4 → N9 (upper path) -->
    <route id="route1_forward" edges="E0 E1 E2 E3"/>
    
    <!-- Route 2: N1 → N2 → N3 → N8 → N9 (middle path via E9) -->
    <route id="route2_forward" edges="E0 E1 E9 E8"/>
    
    <!-- Route 3: N1 → N5 → N6 → N7 → N8 → N9 (lower path) -->
    <route id="route3_forward" edges="E4 E5 E6 E7 E8"/>
    
    <!-- Route 4: N1 → N2 → N7 → N8 → N9 (via E10 - middle-lower path) -->
    <route id="route4_forward" edges="E0 E10 E7 E8"/>
    
    <!-- ============================================================ -->
    <!-- REVERSE ROUTES (Node9 → Node1) -->
    <!-- ============================================================ -->
    
    <!-- Route 1 Reverse: N9 → N4 → N3 → N2 → N1 (upper path) -->
    <route id="route1_reverse" edges="-E3 -E2 -E1 -E0"/>
    
    <!-- Route 2 Reverse: N9 → N8 → N3 → N2 → N1 (middle path via E9) -->
    <route id="route2_reverse" edges="-E8 -E9 -E1 -E0"/>
    
    <!-- Route 3 Reverse: N9 → N8 → N7 → N6 → N5 → N1 (lower path) -->
    <route id="route3_reverse" edges="-E8 -E7 -E6 -E5 -E4"/>
    
    <!-- Route 4 Reverse: N9 → N8 → N7 → N2 → N1 (via E10 - middle-lower path) -->
    <route id="route4_reverse" edges="-E8 -E7 -E10 -E0"/>
    
    <!-- ============================================================ -->
    <!-- FORWARD DIRECTION FLOWS (Reduced frequency) -->
    <!-- ============================================================ -->
    
    <!-- Easy Bikes - Forward Direction -->
    <flow id="easyBike_forward1" type="easyBike" route="route1_forward" begin="0" end="3600" vehsPerHour="70" departPos="base" departLane="best"/>
    <flow id="easyBike_forward2" type="easyBike" route="route2_forward" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    <flow id="easyBike_forward3" type="easyBike" route="route3_forward" begin="0" end="3600" vehsPerHour="50" departPos="base" departLane="best"/>
    <flow id="easyBike_forward4" type="easyBike" route="route4_forward" begin="0" end="3600" vehsPerHour="45" departPos="base" departLane="best"/>
    
    <!-- E-Rickshaws - Forward Direction -->
    <flow id="eRickshaw_forward1" type="eRickshaw" route="route1_forward" begin="0" end="3600" vehsPerHour="35" departPos="base" departLane="best"/>
    <flow id="eRickshaw_forward2" type="eRickshaw" route="route2_forward" begin="0" end="3600" vehsPerHour="30" departPos="base" departLane="best"/>
    <flow id="eRickshaw_forward3" type="eRickshaw" route="route3_forward" begin="0" end="3600" vehsPerHour="25" departPos="base" departLane="best"/>
    <flow id="eRickshaw_forward4" type="eRickshaw" route="route4_forward" begin="0" end="3600" vehsPerHour="20" departPos="base" departLane="best"/>
    
    <!-- E-Vans - Forward Direction -->
    <flow id="eVan_forward1" type="eVan" route="route1_forward" begin="0" end="3600" vehsPerHour="25" departPos="base" departLane="best"/>
    <flow id="eVan_forward2" type="eVan" route="route2_forward" begin="0" end="3600" vehsPerHour="20" departPos="base" departLane="best"/>
    <flow id="eVan_forward3" type="eVan" route="route3_forward" begin="0" end="3600" vehsPerHour="15" departPos="base" departLane="best"/>
    <flow id="eVan_forward4" type="eVan" route="route4_forward" begin="0" end="3600" vehsPerHour="10" departPos="base" departLane="best"/>
    
    <!-- ============================================================ -->
    <!-- REVERSE DIRECTION FLOWS (Higher frequency for return traffic) -->
    <!-- ============================================================ -->
    
    <!-- Easy Bikes - Reverse Direction -->
    <flow id="easyBike_reverse1" type="easyBike" route="route1_reverse" begin="0" end="3600" vehsPerHour="90" departPos="base" departLane="best"/>
    <flow id="easyBike_reverse2" type="easyBike" route="route2_reverse" begin="0" end="3600" vehsPerHour="80" departPos="base" departLane="best"/>
    <flow id="easyBike_reverse3" type="easyBike" route="route3_reverse" begin="0" end="3600" vehsPerHour="70" departPos="base" departLane="best"/>
    <flow id="easyBike_reverse4" type="easyBike" route="route4_reverse" begin="0" end="3600" vehsPerHour="60" departPos="base" departLane="best"/>
    
    <!-- E-Rickshaws - Reverse Direction -->
    <flow id="eRickshaw_reverse1" type="eRickshaw" route="route1_reverse" begin="0" end="3600" vehsPerHour="50" departPos="base" departLane="best"/>
    <flow id="eRickshaw_reverse2" type="eRickshaw" route="route2_reverse" begin="0" end="3600" vehsPerHour="40" departPos="base" departLane="best"/>
    <flow id="eRickshaw_reverse3" type="eRickshaw" route="route3_reverse" begin="0" end="3600" vehsPerHour="35" departPos="base" departLane="best"/>
    <flow id="eRickshaw_reverse4" type="eRickshaw" route="route4_reverse" begin="0" end="3600" vehsPerHour="30" departPos="base" departLane="best"/>
    
    <!-- E-Vans - Reverse Direction -->
    <flow id="eVan_reverse1" type="eVan" route="route1_reverse" begin="0" end="3600" vehsPerHour="35" departPos="base" departLane="best"/>
    <flow id="eVan_reverse2" type="eVan" route="route2_reverse" begin="0" end="3600" vehsPerHour="25" departPos="base" departLane="best"/>
    <flow id="eVan_reverse3" type="eVan" route="route3_reverse" begin="0" end="3600" vehsPerHour="20" departPos="base" departLane="best"/>
    <flow id="eVan_reverse4" type="eVan" route="route4_reverse" begin="0" end="3600" vehsPerHour="15" departPos="base" departLane="best"/>

</routes>