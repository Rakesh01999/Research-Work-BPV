<?xml version="1.0" encoding="UTF-8"?>
<additional xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/additional_file.xsd">

    <!-- ============================================================ -->
    <!-- CORRECTED TRAFFIC LIGHT CONFIGURATION FOR NODE3 -->
    <!-- ============================================================ -->
    <!-- Node3 has 8 connections (linkIndex 0-7):
         0: -E9 -> -E1 (left turn)
         1: -E9 -> E2 (right turn)
         2: -E2 -> E9 (left turn)
         3: -E2 -> -E1 (straight, lane 0)
         4: -E2 -> -E1 (straight, lane 1)
         5: E1 -> E2 (straight, lane 0)
         6: E1 -> E2 (straight, lane 1)
         7: E1 -> E9 (right turn)
    -->
    <tlLogic id="Node3" type="static" programID="0" offset="0">
        <!-- Phase 0: E1 -> E2 (Main road straight through) - GREEN (50 seconds) -->
        <!-- State order: 0  1  2  3  4  5  6  7 -->
        <!--             -E9 -E9 -E2 -E2 -E2 E1  E1  E1  -->
        <phase duration="50" state="rrrrGGGg"/>
        
        <!-- Phase 1: Yellow transition for E1 -> E2 (3 seconds) -->
        <phase duration="3" state="rrrrryyy"/>
        
        <!-- Phase 2: -E2 -> -E1 and -E2 -> E9 (From Node4 direction) - GREEN (35 seconds) -->
        <phase duration="35" state="rrGGGrrr"/>
        
        <!-- Phase 3: Yellow transition for -E2 (3 seconds) -->
        <phase duration="3" state="rryyyrrr"/>
        
        <!-- Phase 4: -E9 turns (From Node8 direction) - GREEN (25 seconds) -->
        <phase duration="25" state="GGrrrrr"/>
        
        <!-- Phase 5: Yellow transition for -E9 (3 seconds) -->
        <phase duration="3" state="yyrrrrrr"/>
        
        <!-- Phase 6: All red safety clearance (2 seconds) -->
        <phase duration="2" state="rrrrrrrr"/>
    </tlLogic>

    <!-- ============================================================ -->
    <!-- CORRECTED TRAFFIC LIGHT CONFIGURATION FOR NODE8 -->
    <!-- ============================================================ -->
    <!-- Node8 has 8 connections (linkIndex 0-7):
         0: -E8 -> -E7 (straight, lane 0)
         1: -E8 -> -E7 (straight, lane 1)
         2: -E8 -> -E9 (right turn)
         3: E9 -> E8 (left turn)
         4: E9 -> -E7 (right turn)
         5: E7 -> -E9 (left turn)
         6: E7 -> E8 (straight, lane 0)
         7: E7 -> E8 (straight, lane 1)
    -->
    <tlLogic id="Node8" type="static" programID="0" offset="0">
        <!-- Phase 0: E7 -> E8 (Main road straight through from Node7) - GREEN (50 seconds) -->
        <!-- State order: 0  1  2  3  4  5  6  7 -->
        <!--             -E8 -E8 -E8 E9  E9  E7  E7  E7  -->
        <phase duration="50" state="rrrrrGGG"/>
        
        <!-- Phase 1: Yellow transition for E7 (3 seconds) -->
        <phase duration="3" state="rrrrryy"/>
        
        <!-- Phase 2: -E8 -> -E7 (From Node9 direction straight) - GREEN (35 seconds) -->
        <phase duration="35" state="GGgrrrrr"/>
        
        <!-- Phase 3: Yellow transition for -E8 (3 seconds) -->
        <phase duration="3" state="yyyrrrrr"/>
        
        <!-- Phase 4: E9 turns and E7 -> -E9 (Turning movements) - GREEN (25 seconds) -->
        <phase duration="25" state="rrrGGGrr"/>
        
        <!-- Phase 5: Yellow transition for turns (3 seconds) -->
        <phase duration="3" state="rrryyyrr"/>
        
        <!-- Phase 6: All red safety clearance (2 seconds) -->
        <phase duration="2" state="rrrrrrrr"/>
    </tlLogic>

</additional>