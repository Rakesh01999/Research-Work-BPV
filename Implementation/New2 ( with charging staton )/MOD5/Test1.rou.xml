<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- ============================================================ -->
    <!-- ELECTRIC VEHICLE TYPES WITH REAL BANGLADESH MARKET DATA -->
    <!-- Based on actual Easy Bike, E-Rickshaw, and E-Van specifications -->
    <!-- Data source: Bangladesh market survey 2024-2025 -->
    <!-- ============================================================ -->
    
    <!-- 
    EASY BIKE (E-Bike/Easy Bike Standard)
    Real Market Data:
    - Models: Easy Bike Ltd., Auto Gari Standard, Mishuk
    - Motor: 800W-1000W (Average: 900W)
    - Range: 60-90 km (Average: 75 km)
    - Seating: 3-5 passengers
    - Battery: Typically 48V-60V, 40-50Ah
    - Price: 1,15,000 - 1,80,000 BDT
    - Weight: ~200 kg estimated (not specified in data)
    -->
    <vType id="easyBike" 
           accel="1.2" decel="4.5" sigma="0.8" 
           length="2.2" width="0.8" height="1.4" 
           maxSpeed="19.44" 
           color="0.9,0.3,0.9" 
           minGap="0.5" tau="0.9" speedFactor="1.05" 
           emissionClass="Energy/unknown">
        <!-- Battery Device Parameters - Based on Real Market Data -->
        <param key="has.battery.device" value="true"/>
        
        <!-- Battery Capacity Calculation:
             Average: 54V × 45Ah = 2,430 Wh ≈ 2.4 kWh
             Range: 75 km average
             Energy per km: 2430 Wh / 75 km = 32.4 Wh/km
        -->
        <param key="maximumBatteryCapacity" value="2430"/>        <!-- 2.43 kWh (54V 45Ah typical) -->
        <param key="actualBatteryCapacity" value="2187"/>         <!-- Start at 90% (2187 Wh) -->
        
        <!-- Motor: 900W average (800W-1000W range) -->
        <param key="maximumPower" value="900"/>                   <!-- 900W motor -->
        
        <!-- Vehicle Mass: Estimated 200kg (vehicle) + 150kg (3 passengers avg) -->
        <param key="vehicleMass" value="350"/>                    <!-- 350 kg total -->
        
        <!-- Aerodynamics - Small frontal area, moderate drag -->
        <param key="frontSurfaceArea" value="1.0"/>               <!-- ~1.0 m² frontal area -->
        <param key="airDragCoefficient" value="0.75"/>            <!-- Moderate aerodynamics -->
        
        <!-- Drivetrain Parameters -->
        <param key="internalMomentOfInertia" value="0.01"/>       
        <param key="radialDragCoefficient" value="0.12"/>         <!-- Rolling resistance -->
        <param key="rollDragCoefficient" value="0.015"/>
        
        <!-- Power Consumption -->
        <param key="constantPowerIntake" value="30"/>             <!-- 30W (lights, display, etc.) -->
        
        <!-- Motor Efficiency (brushless DC motors, typical 80-85%) -->
        <param key="propulsionEfficiency" value="0.82"/>          <!-- 82% motor efficiency -->
        <param key="recuperationEfficiency" value="0.65"/>        <!-- 65% regen (basic system) -->
        
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- 
    E-RICKSHAW (Electric Rickshaw)
    Real Market Data:
    - Models: Mishuk 5 Battery, TomTom, Local conversions, Akij-Songi
    - Motor: 800W-1500W (Average: 1200W)
    - Range: 60-100 km (Average: 80 km)
    - Seating: 3-6 passengers (typically 4)
    - Battery: 60V 45Ah typical (Akij-Songi spec)
    - Price: 1,00,000 - 1,90,000 BDT
    - Weight: 190 kg (Akij-Songi) + passengers
    - Loading Capacity: 240 kg (Akij-Songi)
    - Charging: 8-10 hours
    - Max Speed: 25-35 km/h
    -->
    <vType id="eRickshaw" 
           accel="0.6" decel="2.5" sigma="0.7" 
           length="2.5" width="1.0" height="1.8" 
           maxSpeed="6.94" 
           color="0,0.9,0" 
           minGap="0.8" tau="2.0" speedFactor="0.8" 
           emissionClass="Energy/unknown">
        <!-- Battery Device Parameters - Based on Akij-Songi (60V 45Ah) -->
        <param key="has.battery.device" value="true"/>
        
        <!-- Battery Capacity Calculation:
             Akij-Songi: 60V × 45Ah = 2,700 Wh = 2.7 kWh
             Range: 60 km (per spec)
             Energy per km: 2700 / 60 = 45 Wh/km
        -->
        <param key="maximumBatteryCapacity" value="2700"/>        <!-- 2.7 kWh (60V 45Ah) -->
        <param key="actualBatteryCapacity" value="2430"/>         <!-- Start at 90% (2430 Wh) -->
        
        <!-- Motor: Akij-Songi 1500W -->
        <param key="maximumPower" value="1500"/>                  <!-- 1500W motor -->
        
        <!-- Vehicle Mass: Akij-Songi 190kg + 240kg load capacity = 430kg full -->
        <param key="vehicleMass" value="350"/>                    <!-- 350 kg (vehicle + avg passengers) -->
        
        <!-- Aerodynamics - Larger frontal area, poor aerodynamics -->
        <param key="frontSurfaceArea" value="1.5"/>               <!-- ~1.5 m² frontal area -->
        <param key="airDragCoefficient" value="0.90"/>            <!-- Poor aerodynamics (boxy shape) -->
        
        <!-- Drivetrain Parameters -->
        <param key="internalMomentOfInertia" value="0.01"/>       
        <param key="radialDragCoefficient" value="0.15"/>         <!-- Higher rolling resistance -->
        <param key="rollDragCoefficient" value="0.018"/>
        
        <!-- Power Consumption -->
        <param key="constantPowerIntake" value="25"/>             <!-- 25W constant draw -->
        
        <!-- Motor Efficiency (brushed DC motors, lower efficiency 75-80%) -->
        <param key="propulsionEfficiency" value="0.78"/>          <!-- 78% motor efficiency -->
        <param key="recuperationEfficiency" value="0.50"/>        <!-- 50% regen (basic/none) -->
        
        <param key="stoppingThreshold" value="0.1"/>
    </vType>
    
    <!-- 
    E-VAN (Electric Van / Cargo Auto)
    Real Market Data:
    - Models: Heavy Chinese Cargo, Cargo Transport, Akij-EVR, High-End Lithium
    - Motor: 1000W-4000W (Average for cargo: 2000W, passenger: 4000W)
    - Range: 60-160 km (Average: 100 km)
    - Seating: 2-8 passengers or heavy cargo
    - Battery: 48V-72V, 100-150Ah (Akij-EVR: 48V 150Ah)
    - Price: 1,90,000 - 4,00,000 BDT
    - Weight: 890 kg (Akij-EVR) + 680 kg load capacity
    - Charging: 8-10 hours
    - Max Speed: 40-60 km/h
    -->
    <vType id="eVan" 
           accel="0.7" decel="3.2" sigma="0.6" 
           length="2.5" width="2.0" height="2.2" 
           maxSpeed="13.89" 
           color="0.2,0.6,0.9" 
           minGap="2.0" tau="1.8" speedFactor="0.85" 
           emissionClass="Energy/unknown">
        <!-- Battery Device Parameters - Based on Akij-EVR (48V 150Ah) -->
        <param key="has.battery.device" value="true"/>
        
        <!-- Battery Capacity Calculation:
             Akij-EVR: 48V × 150Ah = 7,200 Wh = 7.2 kWh
             Average market: 60V × 100Ah = 6,000 Wh = 6.0 kWh
             Using: 6.5 kWh as average
             Range: 60 km (conservative, loaded)
             Energy per km: 6500 / 60 = 108 Wh/km
        -->
        <param key="maximumBatteryCapacity" value="6500"/>        <!-- 6.5 kWh average -->
        <param key="actualBatteryCapacity" value="5850"/>         <!-- Start at 90% (5850 Wh) -->
        
        <!-- Motor: Average 3000W (range 2000W-4000W) -->
        <param key="maximumPower" value="3000"/>                  <!-- 3000W motor -->
        
        <!-- Vehicle Mass: Akij-EVR 890kg + 400kg avg load = 1290kg -->
        <param key="vehicleMass" value="1100"/>                   <!-- 1100 kg (vehicle + load) -->
        
        <!-- Aerodynamics - Large frontal area, van shape -->
        <param key="frontSurfaceArea" value="2.8"/>               <!-- ~2.8 m² frontal area -->
        <param key="airDragCoefficient" value="0.85"/>            <!-- Van aerodynamics -->
        
        <!-- Drivetrain Parameters -->
        <param key="internalMomentOfInertia" value="0.01"/>       
        <param key="radialDragCoefficient" value="0.18"/>         <!-- Higher rolling resistance (heavy) -->
        <param key="rollDragCoefficient" value="0.015"/>
        
        <!-- Power Consumption -->
        <param key="constantPowerIntake" value="80"/>             <!-- 80W (lights, systems, AC) -->
        
        <!-- Motor Efficiency (better motors for commercial use, 82-88%) -->
        <param key="propulsionEfficiency" value="0.85"/>          <!-- 85% motor efficiency -->
        <param key="recuperationEfficiency" value="0.70"/>        <!-- 70% regen efficiency -->
        
        <param key="stoppingThreshold" value="0.1"/>
    </vType>

